{
  "name": "lina-location-map",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build && node scripts/check-deployment.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "build:github": "tsc && vite build --mode github-pages && node scripts/check-deployment.mjs github-pages",
    "check:github": "npm run test && npm run data:validate && npm run build:github",
    "preview:github": "vite preview --mode github-pages --host 127.0.0.1",
    "test": "vitest run",
    "check": "npm run test && npm run data:validate && npm run build && wrangler pages functions build --outdir .wrangler/verify",
    "pages:login": "wrangler login",
    "pages:create": "wrangler pages project create --production-branch main",
    "pages:bootstrap": "node scripts/prepare-bootstrap.mjs && wrangler pages deploy .wrangler/bootstrap --branch main",
    "pages:dev": "npm run build && wrangler pages dev dist --ip 127.0.0.1",
    "pages:deploy": "npm run check && wrangler pages deploy dist --branch main",
    "pages:verify": "node scripts/check-private-site.mjs",
    "data:build-density": "tsx scripts/build-density-overlay.ts",
    "data:refresh-places": "tsx scripts/refresh-places.ts",
    "data:refresh-overture": "tsx scripts/refresh-overture.ts",
    "data:build-stations": ".venv/bin/python scripts/build-stations.py",
    "data:refresh-stations": ".venv/bin/python scripts/build-stations.py --download",
    "data:score": "tsx scripts/score.ts",
    "data:validate": "tsx scripts/validate-data.ts"
  },
  "dependencies": {
    "jose": "^6.2.12",
    "lucide-react": "^0.542.0",
    "maplibre-gl": "^6.9.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/google.maps": "^3.58.1",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^4.7.0",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "vite": "^5.4.21",
    "vitest": "^3.2.4",
    "wrangler": "^4.131.1",
    "xlsx": "^0.18.5"
  }
}
